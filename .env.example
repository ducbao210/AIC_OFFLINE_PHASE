# Thư mục gốc dữ liệu AIC
AIC_DATA_ROOT=/data/AIC_26_DATA

# SQLite
AIC_SQLITE_PATH=./data/aic.sqlite

# --- Storage backend ---
# "minio" (default) hoặc "local" (cho Google Colab / Google Drive)
AIC_STORAGE_BACKEND=minio
# AIC_STORAGE_LOCAL_ROOT=./data/storage

# MinIO / S3 (chỉ dùng khi AIC_STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

MINIO_BUCKET_RAW=aic-raw
MINIO_BUCKET_FRAMES=aic-frames
MINIO_BUCKET_FEATS=aic-feats

# Tuỳ chọn
AIC_WORKERS=8
AIC_OBJECT_MIN_SCORE=0.25

# --- ASR (Whisper) ---
AIC_ASR_MODEL=small
AIC_ASR_LANGUAGE=vi
AIC_ASR_DEVICE=cuda
AIC_ASR_BATCH_SIZE=16

# --- Captioning (BLIP-2) ---
AIC_CAPTION_MODEL=Salesforce/blip2-opt-2.7b
AIC_CAPTION_DEVICE=cuda
AIC_CAPTION_MAX_NEW_TOKENS=64